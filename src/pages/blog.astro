---
import BaseLayout from '../layouts/BaseLayout.astro';
import { graphQLClient, gql } from '../lib/graphql';

const GET_POSTS = gql`
  query GetPosts {
    posts(where: { tagSlugIn: ["bamteam", "all"] }) {
      nodes {
        title
        uri
        excerpt
        date
        featuredImage {
          node {
            sourceUrl
            altText
            mediaDetails {
              width
              height
            }
          }
        }
        tags {
          nodes {
            name
            slug
          }
        }
      }
    }
  }
`;

let posts = [];
try {
  const data = await graphQLClient.request(GET_POSTS);
  posts = data.posts.nodes;
} catch (error) {
  console.error("Error fetching posts:", error);
}
---

<BaseLayout title="Blog" description="Latest insights and articles from BAM Team Services LLC">
	<section class="py-16 md:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">Blog & Insights</h1>
				<p class="text-xl text-gray-600 max-w-3xl mx-auto">
					Thoughts on technology, business transformation, and creating positive change.
				</p>
			</div>

			{posts.length > 0 ? (
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					{posts.map((post) => (
						<article class="bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow border border-gray-100 overflow-hidden group">
							{post.featuredImage && post.featuredImage.node && (
								<a href={`/posts/${post.uri}`} class="block overflow-hidden">
									<img 
										src={post.featuredImage.node.sourceUrl} 
										alt={post.featuredImage.node.altText || post.title} 
										width={post.featuredImage.node.mediaDetails.width} 
										height={post.featuredImage.node.mediaDetails.height} 
										class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" 
									/>
								</a>
							)}
							<div class="p-6">
								<div class="flex items-center text-sm text-gray-500 mb-3">
									{post.date && (
										<time datetime={post.date}>
											{new Date(post.date).toLocaleDateString('en-US', { 
												year: 'numeric', 
												month: 'long', 
												day: 'numeric' 
											})}
										</time>
									)}
									{post.tags && post.tags.nodes.length > 0 && (
										<>
											<span class="mx-2">•</span>
											<span>{post.tags.nodes.map(tag => tag.name).join(', ')}</span>
										</>
									)}
								</div>
								<h2 class="text-xl font-semibold text-gray-900 mb-3 group-hover:text-gray-700 transition-colors">
									<a href={`/posts/${post.uri}`} class="hover:underline">
										{post.title}
									</a>
								</h2>
								{post.excerpt && (
									<div class="text-gray-600 mb-4 line-clamp-3" set:html={post.excerpt} />
								)}
								<a href={`/posts/${post.uri}`} class="inline-flex items-center text-gray-900 hover:text-gray-700 font-medium">
									Read More
									<svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
									</svg>
								</a>
							</div>
						</article>
					))}
				</div>
			) : (
				<div class="text-center py-16">
					<svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
					</svg>
					<p class="text-gray-600 text-xl">No posts found.</p>
					<p class="text-gray-500 mt-2">Please add posts in your WordPress CMS with the tag "bamteamservices" or "all".</p>
				</div>
			)}
		</div>
	</section>
</BaseLayout>