---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Services" description="Comprehensive technology and business consulting services from BAM Team Services LLC">
	<section class="relative bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 py-20 md:py-32 overflow-hidden">
		<div class="absolute inset-0 overflow-hidden">
			<div class="absolute inset-0 bg-gradient-to-r from-blue-600/20 via-transparent to-emerald-600/20"></div>
			<div class="absolute top-20 left-1/4 w-2 h-2 bg-blue-400 rounded-full animate-pulse"></div>
			<div class="absolute bottom-32 right-1/3 w-3 h-3 bg-emerald-400 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
		</div>
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
			<div class="text-center mb-16">
				<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">
						Our Services
					</span>
				</h1>
				<p class="text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
					Leveraging decades of experience to deliver transformative solutions that drive real business value.
				</p>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-gradient-to-b from-white to-slate-50">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

			<div class="space-y-12">
				<div class="group bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl shadow-xl border border-blue-200 hover:border-blue-300 p-8 md:p-12 transform hover:-translate-y-2 transition-all duration-300">
					<div class="flex items-start">
						<div class="flex-shrink-0">
							<div class="w-20 h-20 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
								<svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
							</div>
						</div>
						<div class="ml-8 flex-1">
							<h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-blue-900 mb-6">Business Consulting and Transformation</h2>
							<p class="text-slate-700 mb-6 text-lg leading-relaxed">
								Navigate complex business challenges with strategic guidance informed by decades of successful transformations. We help organizations reimagine their operations, optimize processes, and achieve sustainable growth.
							</p>
							<ul class="space-y-3 text-slate-600">
								<li class="flex items-start">
									<svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
									</svg>
									Strategic planning and roadmap development
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
									</svg>
									Process optimization and efficiency improvement
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
									</svg>
									Digital transformation strategy
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
									</svg>
									Change management and implementation
								</li>
							</ul>
						</div>
					</div>
				</div>

				<div class="group bg-gradient-to-br from-emerald-50 to-emerald-100 rounded-2xl shadow-xl border border-emerald-200 hover:border-emerald-300 p-8 md:p-12 transform hover:-translate-y-2 transition-all duration-300">
					<div class="flex items-start">
						<div class="flex-shrink-0">
							<div class="w-20 h-20 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
								<svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
								</svg>
							</div>
						</div>
						<div class="ml-8 flex-1">
							<h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-emerald-700 to-emerald-900 mb-6">Startup Advisor</h2>
							<p class="text-gray-600 mb-6">
								Guide your startup from concept to scale with insights from someone who's built and advised numerous successful ventures. Benefit from battle-tested strategies and avoid common pitfalls.
							</p>
							<ul class="space-y-3 text-gray-600">
								<li class="flex items-start">
									<svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
									</svg>
									Business model validation and refinement
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
