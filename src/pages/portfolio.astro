---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Portfolio" description="Business units and ventures supported by BAM Team Services LLC">
	<section class="py-16 md:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-16">
				<h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">Our Portfolio</h1>
				<p class="text-xl text-gray-600 max-w-3xl mx-auto">
					BAM Team Services supports a diverse portfolio of innovative ventures, each dedicated to creating positive impact through technology and strategic thinking.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
				<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-8 hover:shadow-md transition-shadow">
					<div class="mb-6">
						<div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-600 rounded-lg flex items-center justify-center text-white font-bold text-xl">
							AM
						</div>
					</div>
					<h2 class="text-2xl font-semibold text-gray-900 mb-3">acmemarketing.us</h2>
					<p class="text-gray-600 mb-6">
						Strategic marketing solutions that drive growth and engagement. ACME Marketing combines data-driven insights with creative excellence to deliver measurable results for businesses of all sizes.
					</p>
					<div class="space-y-2 mb-6">
						<div class="flex items-center text-sm text-gray-500">
							<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							Digital Marketing Strategy
						</div>
						<div class="flex items-center text-sm text-gray-500">
							<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							Brand Development
						</div>
						<div class="flex items-center text-sm text-gray-500">
							<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							Content Marketing
						</div>
					</div>
					<a href="https://acmemarketing.us" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-gray-900 hover:text-gray-700 font-medium">
						Visit Website
						<svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
						</svg>
					</a>
				</div>

				<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-8 hover:shadow-md transition-shadow">
					<div class="mb-6">
						<div class="w-16 h-16 bg-gradient-to-br from-green-500 to-teal-600 rounded-lg flex items-center justify-center text-white font-bold text-xl">
							BF
						</div>
					</div>
					<h2 class="text-2xl font-semibold text-gray-900 mb-3">bemorefree.com</h2>
					<p class="text-gray-600 mb-6">
						Empowering individuals and organizations to break free from limitations and achieve their full potential. Be More Free offers tools, resources, and guidance for personal and professional liberation.
