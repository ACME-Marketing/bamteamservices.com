---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "BAM Team Services LLC - Technology and Business Process Whisperer" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | BAM Team Services LLC</title>
	</head>
	<body class="min-h-screen flex flex-col bg-white">
		<nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center h-16">
					<div class="flex items-center">
						<a href="/" class="text-xl font-semibold text-gray-900">BTS</a>
					</div>
					<div class="hidden md:block">
						<div class="ml-10 flex items-baseline space-x-8">
							<a href="/" class="text-gray-900 hover:text-gray-600 px-3 py-2 text-sm font-medium transition-colors">Home</a>
							<a href="/about" class="text-gray-900 hover:text-gray-600 px-3 py-2 text-sm font-medium transition-colors">About</a>
							<a href="/services" class="text-gray-900 hover:text-gray-600 px-3 py-2 text-sm font-medium transition-colors">Services</a>
							<a href="/portfolio" class="text-gray-900 hover:text-gray-600 px-3 py-2 text-sm font-medium transition-colors">Portfolio</a>
							<a href="/blog" class="text-gray-900 hover:text-gray-600 px-3 py-2 text-sm font-medium transition-colors">Blog</a>
							<a href="/contact" class="text-gray-900 hover:text-gray-600 px-3 py-2 text-sm font-medium transition-colors">Contact</a>
						</div>
					</div>
					<div class="md:hidden">
						<button type="button" class="mobile-menu-button inline-flex items-center justify-center p-2 rounded-md text-gray-900 hover:text-gray-600 focus:outline-none">
							<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
							</svg>
						</button>
					</div>
				</div>
			</div>
			<div class="mobile-menu hidden md:hidden">
				<div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
					<a href="/" class="text-gray-900 hover:text-gray-600 block px-3 py-2 text-base font-medium">Home</a>
					<a href="/about" class="text-gray-900 hover:text-gray-600 block px-3 py-2 text-base font-medium">About</a>
					<a href="/services" class="text-gray-900 hover:text-gray-600 block px-3 py-2 text-base font-medium">Services</a>
					<a href="/portfolio" class="text-gray-900 hover:text-gray-600 block px-3 py-2 text-base font-medium">Portfolio</a>
					<a href="/blog" class="text-gray-900 hover:text-gray-600 block px-3 py-2 text-base font-medium">Blog</a>
					<a href="/contact" class="text-gray-900 hover:text-gray-600 block px-3 py-2 text-base font-medium">Contact</a>
				</div>
			</div>
		</nav>
		
		<main class="flex-grow">
			<slot />
		</main>

		<footer class="bg-gray-50 border-t border-gray-200 mt-20">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
				<div class="flex flex-col md:flex-row justify-between items-center">
					<div class="mb-4 md:mb-0">
						<p class="text-gray-600 text-sm">&copy; {new Date().getFullYear()} BAM Team Services LLC. All rights reserved.</p>
					</div>
					<div class="flex space-x-6">
						<a href="/privacy" class="text-gray-600 hover:text-gray-900 text-sm">Privacy Policy</a>
						<a href="/terms" class="text-gray-600 hover:text-gray-900 text-sm">Terms of Service</a>
					</div>
				</div>
			</div>
		</footer>

		<script>
			document.querySelector('.mobile-menu-button')?.addEventListener('click', () => {
				document.querySelector('.mobile-menu')?.classList.toggle('hidden');
			});
		</script>
	</body>
</html>